# ---------- 環境變數 ----------
.env
.env.local
.env.*.local

# ---------- Java / Maven ----------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
!.mvn/wrapper/*.jar
*.war
*.ear
*.logs
hs_err_pid*
replay_pid*

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/
.nyc_output/
*.tsbuildinfo

# ---------- 上傳檔案（執行期產生，不進版控） ----------
uploads/
!uploads/.gitkeep

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.settings/
.project
.classpath
.factorypath
nbproject/private/
build/
