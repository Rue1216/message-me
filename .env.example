# 複製此檔為 .env 後填入實際值：cp .env.example .env
# .env 已列入 .gitignore，切勿提交至版控。

# ---------- 資料庫 ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=message_me
MYSQL_USER=app_user
MYSQL_PASSWORD=change-me-app-password

# ---------- JWT ----------
# 請填入至少 32 位元組的隨機字串，例如：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=120

# ---------- 對外連接埠 ----------
# 前端固定使用 3001（容器內外一致）。後端 8081 與資料庫 3306 只在容器網路內，不對外開放。
WEB_PORT=3001
